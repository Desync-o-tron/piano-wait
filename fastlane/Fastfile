default_platform(:ios)

platform :ios do
  private_lane :asc_api_key do
    key_id = ENV["APP_STORE_API_KEY_ID"] || "362BK739MY"
    issuer_id = ENV["APP_STORE_API_ISSUER_ID"] || "cd0c881b-f57b-4030-9d14-73f868ececb6"
    key_path = ENV["APP_STORE_API_KEY_PATH"] || File.expand_path("~/.private_keys/AuthKey_#{key_id}.p8")

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )
  end

  desc "Run SwiftPM unit tests and Simulator UI tests"
  lane :test do
    sh("cd .. && swift test")
    run_tests(
      project: "PianoWait.xcodeproj",
      scheme: "PianoWait",
      destination: "platform=iOS Simulator,name=iPhone 17"
    )
  end

  desc "Build signed App Store archive and export IPA"
  lane :build_archive do
    sh("cd .. && ./tools/release_appstore.sh --archive --export")
  end

  desc "Upload a new build to TestFlight"
  lane :beta do
    api_key = asc_api_key
    sh("cd .. && ./tools/release_appstore.sh --archive --export")
    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/export/PianoWait.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload metadata and binary to App Store Connect"
  lane :release do
    api_key = asc_api_key
    sh("cd .. && ./tools/release_appstore.sh --archive --export")
    deliver(
      api_key: api_key,
      ipa: "./build/export/PianoWait.ipa",
      metadata_path: "./fastlane/metadata",
      app_rating_config_path: "./fastlane/age_rating_declaration.json",
      skip_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end
end
